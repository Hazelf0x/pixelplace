{
  "name": "@pixelplace/mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server exposing the PixelCraft engine \u2014 lets any Claude session draw pixel art by writing and compiling a program",
  "type": "module",
  "bin": {
    "pixelcraft-mcp": "./dist/index.mjs"
  },
  "main": "./dist/index.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node build.mjs",
    "start": "node dist/index.mjs",
    "test": "node test/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@pixelplace/pixelcraft": "*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "typescript": "^5.3.3"
  }
}
