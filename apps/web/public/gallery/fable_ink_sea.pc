## The Ink Sea
## The world is a page: a ruled paper sky, a sketched sun, and below the
## horizon a sea of spilled ink that holds the night. A giant fountain pen
## stands nib-down at the horizon, still writing the sea; a paper boat
## sails the ink while letters rise out of the water like fireflies.
## Made by Claude Fable 5 - a fable being written.
version 0.1
canvas 80x56

# --- paper world ---
pal paper0=#f4ead2 paper1=#ead9b4 paper2=#ddc697
pal+ ruleInk=#c9b68d55 marginInk=#c96a5a44 sketch=#262238
# --- ink world ---
pal+ inkHz=#3a3f75 ink2=#23264d ink1=#191b3a ink0=#101126
pal+ inkHi=#5a60a8 inkLo=#262a55 starW=#fdfdff starG=#ffd98c
# --- boat ---
pal+ boatW=#fffaf0 boatSh=#d8cbb2 flagRed=#c8503e reflW=#fffaf022
# --- pen ---
pal+ barrel0=#4a1f2e barrel1=#6e2f3f barrelHi=#a05a62
pal+ goldB=#d9a441 goldHi=#ffe6a3 metalM=#565a75 metalHi=#9aa0bd metalD=#2e2e38
# --- light and motion ---
pal+ sunRef=#ffd98c66 penGlow=#9fe9ff2a
pal+ rip0=#9fe9ffcc rip1=#7f9fe288 rip2=#5566aa55
pal+ moteInk=#26223899 moteGold=#ffd98cbb

const horizonY = 30

bitmap "seastar" map S=starW {
  "S"
}

bitmap "glyph_o" map G=moteInk {
  ".G."
  "G.G"
  ".G."
}

bitmap "glyph_i" map G=moteInk {
  "G"
  "."
  "G"
}

bitmap "gold_spark" map G=moteGold {
  "G"
}

# the boat is rigid, so it lives in a group and bobs as one stamp
group "paper_boat" pivot 7,13 {
  # sail with a soft shaded half and a fold line
  poly 7,1 2,9 12,9 boatW
  poly 7,1 12,9 7,9 boatSh
  line 7,2 7,8 boatSh
  line 7,1 2,9 sketch
  line 7,1 12,9 sketch
  # hull
  poly 0,9 14,9 10,13 4,13 boatW
  poly 7,9 14,9 10,13 7,13 boatSh
  line 0,9 14,9 sketch
  line 0,9 4,13 sketch
  line 14,9 10,13 sketch
  line 4,13 10,13 ink1
  # little wax-red pennant
  px 7,0 8,0 flagRed
}

# --- the page (sky) ---
layer "sky"
rect 0,0 80x10 paper0
rect 0,10 80x10 paper1
rect 0,20 80x10 paper2
dither bayer at 0,8 80x4 paper0 paper1
dither bayer at 0,18 80x4 paper1 paper2

# ruled notebook lines and the red margin
layer "page"
line 0,6 79,6 ruleInk
line 0,13 79,13 ruleInk
line 0,20 79,20 ruleInk
line 0,27 79,27 ruleInk
line 10,0 10,29 marginInk

# a sketched, slightly unfinished sun
ocirc 66,9 4 sketch
px 70,9 paper1
line 66,2 66,3 sketch
line 71,4 72,3 sketch
line 73,9 75,9 sketch
line 71,14 72,15 sketch
line 66,15 66,16 sketch
line 61,14 60,15 sketch
line 59,9 57,9 sketch
line 61,4 60,3 sketch

# the last written words trail off toward the pen
line 38,24 43,24 ruleInk
line 45,23 48,23 ruleInk
px 50,22 ruleInk

# --- the ink sea ---
layer "sea"
rect 0,$horizonY 80x2 inkHz
rect 0,32 80x6 ink2
rect 0,38 80x8 ink1
rect 0,46 80x10 ink0
dither bayer at 0,32 80x2 inkHz ink2
dither bayer at 0,37 80x2 ink2 ink1
dither bayer at 0,45 80x2 ink1 ink0

# the night lives in the ink: stars float in the sea
layer "seastars"
scatter "seastar" in 3,33 74x20 count 12 seed 502
px 12,48 44,41 70,52 21,36 starG

# --- the fountain pen, writing the sea ---
layer "pen"
rect 54,0 9x13 barrel1
rect 54,0 2x13 barrel0
rect 61,0 1x13 barrelHi
rect 53,13 11x3 goldB
px 62,13 63,14 goldHi
poly 53,16 63,16 58,31 metalM
line 54,17 57,28 metalHi
line 62,17 59,28 metalD
line 58,23 58,29 metalD
px 58,21 metalD
px 58,22 paper2

timeline 0..47 {
  each {
    let swayX = lerp(-1, 1, sin01($t))
    let bobY = lerp(-1.2, 1.2, sin01($t * 2))
    let wA = lerp(-2, 2, sin01($t))
    let wB = lerp(-2, 2, sin01($t + 0.33))
    let wC = lerp(-2, 2, sin01($t + 0.66))
    let pulse = lerp(3, 5, sin01($t * 3))
    let boatX = 30 + $swayX
    let boatY = 37 + $bobY

    # the nib's soft light where it touches the ink
    with layer "penlight" clear {
      glow (58, 30) $pulse penGlow
    }

    # waves, reflections, and the pen's wavering shadow
    with layer "waves" clear {
      # near-horizon shimmer
      line (8 + $wB),31 (13 + $wB),31 inkHi
      line (30 + $wC),31 (34 + $wC),31 inkHi
      # pen reflection, broken by the water
      line (57 + $wB),33 (57 + $wB),36 ink1
      line (59 + $wC),34 (59 + $wC),38 ink1
      # sun reflection, gold on black ink
      line (63 + $wB),33 (68 + $wB),33 sunRef
      line (64 + $wC),36 (67 + $wC),36 sunRef
      px (65 + $wA),40 sunRef
      # open water
      line (6 + $wA),34 (11 + $wA),34 inkHi
      line (44 + $wA),35 (49 + $wA),35 inkHi
      line (14 + $wB),39 (19 + $wB),39 inkLo
      line (34 + $wB),40 (39 + $wB),40 inkLo
      line (68 + $wB),41 (73 + $wB),41 inkLo
      line (8 + $wC),45 (14 + $wC),45 inkLo
      line (28 + $wC),47 (33 + $wC),47 inkLo
      line (52 + $wC),46 (58 + $wC),46 inkLo
      line (18 + $wA),51 (24 + $wA),51 inkLo
      line (60 + $wA),52 (65 + $wA),52 inkLo
    }

    # the paper boat rides the swell as one piece
    with layer "boat" clear {
      stamp "paper_boat" at ($boatX, $boatY) :pivot
      # wake trailing behind
      line (16 + $wA),(39 + $bobY) (22 + $wA),(39 + $bobY) inkHi
      line (12 + $wB),41 (17 + $wB),41 inkLo
      # faint reflection of paper on ink
      px (27 + $swayX),(40 + $bobY) (30 + $swayX),(41 + $bobY) (33 + $swayX),(40 + $bobY) reflW
    }

    # letters rise from the ink around the pen and drift into the page
    with layer "motes" clear {
      emit "glyph_o" at 58,24 count 5 spread 12x16 time $frame vel 0x-1 jitter 1x1 life 22 loop 48 fade seed 41
      emit "glyph_i" at 56,20 count 4 spread 14x14 time $frame vel 0x-1 jitter 1x1 life 26 loop 48 fade seed 73
      # gold dust in the boat's wake
      emit "gold_spark" at ($boatX - 9, $boatY + 2) count 5 spread 8x3 time $frame vel -1x0 jitter 1x1 life 14 loop 48 fade seed 88
    }
  }

  # ripples where the nib keeps writing
  every 16 offset 0 {
    with layer "ripple" clear {
      oellipse 58,31 3x1 rip0
    }
  }
  every 16 offset 4 {
    with layer "ripple" clear {
      oellipse 58,31 6x2 rip1
    }
  }
  every 16 offset 8 {
    with layer "ripple" clear {
      oellipse 58,31 10x3 rip2
    }
  }
  every 16 offset 12 {
    with layer "ripple" clear {
      oellipse 58,31 13x3 rip2
      px 57,31 58,31 59,31 rip0
    }
  }

  # sea-stars twinkle in the ink
  every 8 offset 0 {
    with layer "twinkle" clear {
      glow 12,48 2 sunRef
      glow 63,35 2 penGlow
      px 12,48 63,35 starW
    }
  }
  every 8 offset 4 {
    with layer "twinkle" clear {
      glow 34,50 2 sunRef
      glow 70,52 2 penGlow
      px 34,50 70,52 starW
    }
  }

  # ink birds cross the paper sky
  every 12 offset 0 {
    with layer "birds" clear {
      px 18,8 20,8 sketch
      px 19,9 sketch
      px 26,5 28,5 sketch
      px 27,6 sketch
    }
  }
  every 12 offset 6 {
    with layer "birds" clear {
      px 18,9 20,9 sketch
      px 19,9 sketch
      px 26,6 28,6 sketch
      px 27,6 sketch
    }
  }
}
