# Winter Landscape with Falling Snow (Modern PixelCraft)
canvas 32x32
pal skyDark=#1a1c2c skyHorizon=#2d4a6e snow=#f4f4f4 pine=#2d5a3d pineDark=#1a3a2a trunk=#5a4030 snowBlue=#c8e8f8

# Sky + ground
rect 0,0 32x10 skyDark
rect 0,10 32x14 skyHorizon
rect 0,24 32x8 snow
rect 0,22 12x2 snow
rect 20,23 12x1 snow

# Reusable tree shapes
group "tree_medium" {
  rect 3,13 2x4 trunk
  rect 0,9 8x4 pine
  rect 1,5 6x4 pine
  rect 2,2 4x3 pineDark
  px 3,1 4,1 3,0 4,0 pine
}

group "tree_large" {
  rect 4,17 3x6 trunk
  rect 0,11 11x6 pine
  rect 1,6 9x5 pineDark
  rect 3,2 5x4 pine
  rect 4,0 3x2 pineDark
}

group "tree_small" {
  rect 2,9 2x3 trunk
  rect 0,5 6x4 pine
  rect 1,2 4x3 pineDark
  px 3,1 2,1 2,0 3,0 pine
}

# Scene anchors
anchor treeLeft 2,7
anchor treeCenter 10,1
anchor treeRight 24,12

stamp "tree_medium" at treeLeft
stamp "tree_large" at treeCenter
stamp "tree_small" at treeRight

# Snow caps on tops
px 5,9 14,3 15,3 26,14 snow

frame 1 {
  px 2,3 8,6 19,2 28,5 22,10 30,15 1,22 snow
  px 5,14 12,18 17,20 snowBlue
}

frame 2 {
  px 2,6 8,9 19,5 28,8 22,13 30,18 1,1 snow
  px 5,17 12,21 17,23 snowBlue
}

frame 3 {
  px 2,9 8,12 19,8 28,11 22,16 30,21 1,4 snow
  px 5,20 12,0 17,2 snowBlue
}

frame 4 {
  px 2,12 8,15 19,11 28,14 22,19 30,0 1,7 snow
  px 5,23 12,3 17,5 snowBlue
}

frame 5 {
  px 2,15 8,18 19,14 28,17 22,22 30,3 1,10 snow
  px 5,2 12,6 17,8 snowBlue
}

frame 6 {
  px 2,18 8,21 19,17 28,20 22,1 30,6 1,13 snow
  px 5,5 12,9 17,11 snowBlue
}

frame 7 {
  px 2,21 8,0 19,20 28,23 22,4 30,9 1,16 snow
  px 5,8 12,12 17,14 snowBlue
}

frame 8 {
  px 2,0 8,3 19,23 28,2 22,7 30,12 1,19 snow
  px 5,11 12,15 17,17 snowBlue
}
