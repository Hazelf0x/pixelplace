## Enemy Roster Strip
## Three faction cards laid out with box regions, box-point placement, and box-backed defpt markers
## Showcases: layout boxes, declarative point symbols over box regions, and compact production-style enemy family presentation
version 0.1
canvas 96x34

pal :dawnbringer16
pal+ bg=#081019 panel=#132039 panelDeep=#0d172b frame=#38507d frameHi=#7fa7d8
pal+ moss=#4a8f53 mossHi=#9fd48f bone=#d8d0c4 boneHi=#fff7ea ember=#d66a4a emberHi=#ffc28f
pal+ danger=#c83d55 dangerHi=#ff93a4 ward=#68b8d8 wardHi=#c4f2ff gold=#c9a45e goldHi=#ffe2a1 ink=#04070d shade=#00000044

group "card_frame" pivot 0,0 {
  rect 0,0 28x26 panel
  orect 0,0 28x26 frameHi
  rect 1,1 26x24 panelDeep
  line 3,16 24,16 frame
  line 3,21 24,21 frame
  px 2,2 25,2 2,23 25,23 gold
}

group "health_pip" pivot 0,0 {
  rect 0,0 2x2 moss
  px 1,0 mossHi
}

group "leader_mark" pivot 0,0 {
  poly 0,-3 3,0 0,3 -3,0 gold
  px 0,-2 0,2 goldHi
  px -2,0 2,0 goldHi
}

group "mossling" pivot 0,3 {
  circ 0,-1 5 moss
  rect -4,2 9x5 moss
  px -2,-3 2,-3 mossHi
  line -2,-5 -4,-8 mossHi
  line 2,-5 4,-8 mossHi
  rect -2,4 1x4 bone
  rect 1,4 1x4 bone
  px -2,0 2,0 boneHi
  px -1,1 1,1 ink
  line -1,3 1,3 boneHi
}

group "skullbat" pivot 0,1 {
  poly -8,-1 -3,-5 -1,-2 -5,1 bone
  poly 8,-1 3,-5 1,-2 5,1 bone
  circ 0,-1 4 bone
  rect -2,2 5x2 bone
  px -1,-2 1,-2 boneHi
  px -1,0 1,0 ink
  px -1,3 1,3 danger
}

group "ember_idol" pivot 0,2 {
  rect -5,-4 11x10 ember
  poly -4,-5 0,-9 4,-5 emberHi
  px -2,-2 2,-2 emberHi
  px -2,0 2,0 ink
  rect -1,4 3x2 bone
  px -3,6 3,6 emberHi
  line -4,7 4,7 boneHi
}

group "warning_spark" pivot 0,0 {
  px 0,-2 0,2 -2,0 2,0 emberHi
  px -1,-1 1,-1 -1,1 1,1 ember
}

box strip 2,2 92x30
box cardA box strip topLeft +2,+2 28x26
box cardB box strip topLeft +32,+2 28x26
box cardC box strip topLeft +62,+2 28x26

box portraitA box cardA topLeft +3,+3 22x11
box portraitB box cardB topLeft +3,+3 22x11
box portraitC box cardC topLeft +3,+3 22x11

box badgeA box cardA topRight -4,+4 4x4
box badgeB box cardB topRight -4,+4 4x4
box badgeC box cardC topRight -4,+4 4x4

box meterA box cardA bottomLeft +4,-4 20x2
box meterB box cardB bottomLeft +4,-4 20x2
box meterC box cardC bottomLeft +4,-4 20x2

defpt crownA = box badgeA center
defpt crownB = box badgeB center
defpt crownC = box badgeC center
defpt pingC = box portraitC topRight -2,+1

layer "base"
fill 0,0 bg
stamp "card_frame" at box cardA topLeft :pivot
stamp "card_frame" at box cardB topLeft :pivot
stamp "card_frame" at box cardC topLeft :pivot

rect box portraitA topLeft 22x11 #102116
rect box portraitB topLeft 22x11 #1a1420
rect box portraitC topLeft 22x11 #241611
line box portraitA bottomLeft box portraitA bottomRight frame
line box portraitB bottomLeft box portraitB bottomRight frame
line box portraitC bottomLeft box portraitC bottomRight frame

rect box meterA topLeft 20x2 frame
rect box meterB topLeft 20x2 frame
rect box meterC topLeft 20x2 frame

layer "portraits"
stamp "mossling" at box portraitA center +0,+1 :pivot
stamp "leader_mark" at crownA :pivot
glow box portraitA center 5 #9fd48f18

stamp "skullbat" at box portraitB center +0,+1 :pivot
stamp "leader_mark" at crownB :pivot
glow box portraitB center 4 #ff93a414

stamp "ember_idol" at box portraitC center +0,+1 :pivot
stamp "warning_spark" at pingC :pivot
stamp "leader_mark" at crownC :pivot
glow box portraitC center 6 #ffc28f18

layer "meters"
rect box meterA topLeft 16x2 moss
rect box meterB topLeft 12x2 bone
rect box meterC topLeft 8x2 ember

repeat 4 {
  let x = ($i * 3)
  stamp "health_pip" at box meterA topLeft +($x),+0 :pivot
}

repeat 4 {
  let x = ($i * 3)
  stamp "health_pip" at box meterB topLeft +($x),+0 :pivot
}

repeat 3 {
  let x = ($i * 3)
  stamp "health_pip" at box meterC topLeft +($x),+0 :pivot
}

layer "trim"
px box cardA bottomLeft +3,-7 gold
px box cardA bottomLeft +6,-7 mossHi
px box cardB bottomLeft +3,-7 gold
px box cardB bottomLeft +6,-7 boneHi
px box cardC bottomLeft +3,-7 gold
px box cardC bottomLeft +6,-7 emberHi
