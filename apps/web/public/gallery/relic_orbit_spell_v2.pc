# Relic Orbit Spell v2
# Focus: layered magical VFX with eased motion and emit windows.
canvas 36x24

pal night=#060914 star=#a9b7ff stone=#28344d stoneHi=#4a5e7f
pal relicMetal=#d8e4ff relicCore=#8cf3ff relicHot=#ffffff
pal arc=#294dff..#8be8ff steps 5
pal smoke=#6f88b866 rune=#7acbff runeSoft=#7acbff33

bitmap "star_dot" map S=star {
  "S"
}

bitmap "rune_dot" map R=arc4 {
  "R"
}

bitmap "smoke_dot" map M=smoke {
  "M"
}

bitmap "wisp" map A=arc2 B=arc4 {
  ".A."
  "ABA"
  ".A."
}

group "relic_core" {
  orect 0,0 5x9 relicMetal
  rect 1,1 3x7 #1c2a4a
  rect 2,2 1x5 relicCore
  px 2,1 relicHot
  px 2,7 relicHot
}

layer "bg"
fill 0,0 night
scatter "star_dot" in 0,0 36x9 count 28 seed 44

layer "pedestal"
rect 12,17 12x5 stone
orect 12,17 12x5 stoneHi
rect 14,15 8x2 stoneHi
glow 18,14 4 runeSoft
ocirc 18,14 3 rune

frames 0..7 {
  let t = $frameNumber / 7
  let eased = ease_in_out($t)
  let relicY = lerp(10, 8, $eased)
  let wing = 5 + ($frameNumber % 3)

  push
  layer "relic"
  stamp "relic_core" at (18, $relicY) :center
  glow (18, $relicY) 3 arc3
  pop

  push
  layer "glyphs"
  mirror :x
  line (18 - $wing, $relicY) (18 - 3, $relicY) arc2
  px (18 - $wing - 1, $relicY - 1) arc4
  mirror off
  pop

  push
  layer "fx"
  emit "rune_dot" at (18, $relicY) count 16 spread 10x6 time $frame vel 0x-1 jitter 2x1 active -2..6 fade seed (500 + $frame)
  emit "wisp" at (18, $relicY) count 4 spread 12x5 drift 1x0 time ($frame - 2) jitter 2x1 life 6 fade seed (620 + $frameNumber)
  emit "smoke_dot" at (18, 14) count 8 spread 8x3 time ($frame - 1) vel 0x-1 jitter 1x1 life 6 fade seed (740 + $frame)
  pop
}

frames 8..15 {
  let t = ($frameNumber - 8) / 7
  let eased = ease_in_out($t)
  let relicY = lerp(8, 10, $eased)
  let wing = 5 + ($frameNumber % 3)

  push
  layer "relic"
  stamp "relic_core" at (18, $relicY) :center
  glow (18, $relicY) 3 arc3
  pop

  push
  layer "glyphs"
  mirror :x
  line (18 - $wing, $relicY) (18 - 3, $relicY) arc1
  px (18 - $wing - 1, $relicY + 1) arc4
  mirror off
  pop

  push
  layer "fx"
  emit "rune_dot" at (18, $relicY) count 14 spread 9x6 time $frame vel 0x-1 jitter 2x1 active -2..6 fade seed (900 + $frame)
  emit "wisp" at (18, $relicY) count 4 spread 12x5 drift -1x0 time ($frame - 8) jitter 2x1 life 6 fade seed (1020 + $frameNumber)
  emit "smoke_dot" at (18, 14) count 8 spread 8x3 time ($frame - 8) vel 0x-1 jitter 1x1 life 6 fade seed (1140 + $frame)
  pop
}
