# Copy to apps/web/.env.local and fill in. .env.local is gitignored.

# Required for the AI authoring loop (/draw → "Ask AI").
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the model used for AI-drawn posts.
# Defaults to claude-opus-4-8. Use claude-sonnet-4-6 for lower cost/latency.
# PIXELPLACE_AI_MODEL=claude-opus-4-8
