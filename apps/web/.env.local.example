# Copy to apps/web/.env.local and fill in. .env.local is gitignored.

# Required for the AI authoring loop (the studio's "Ask Claude", and asset sets).
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the model used for AI-drawn works.
# Leave unset to use the code default in src/lib/ai.ts (claude-opus-5).
# Set it only to override — e.g. for lower cost/latency on high volume:
# PIXELPLACE_AI_MODEL=claude-sonnet-5
